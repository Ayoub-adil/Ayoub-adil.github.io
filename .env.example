# ========================================
# PORTFOLIO 3D - VARIABLES D'ENVIRONNEMENT
# ========================================

# Instructions :
# 1. Copiez ce fichier et renommez-le en ".env"
# 2. Remplissez les valeurs ci-dessous avec vos propres clés
# 3. Ne commitez JAMAIS le fichier .env sur GitHub !

# ========================================
# WEB3FORMS - FORMULAIRE DE CONTACT
# ========================================
# Obtenez votre clé gratuite sur https://web3forms.com
# Limite gratuite : 250 soumissions/mois
VITE_WEB3FORMS_KEY=your-web3forms-access-key-here

# ========================================
# EMAILJS (Alternative - Non utilisé actuellement)
# ========================================
# Si vous préférez utiliser EmailJS au lieu de Web3Forms
# VITE_APP_SERVICE_ID=your-service-id
# VITE_APP_TEMPLATE_ID=your-template-id
# VITE_APP_EMAILJS_KEY=your-public-key
# VITE_APP_EMAILJS_RECIEVER=your-email@example.com
